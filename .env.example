# OpsBoard environment variables
# Copy to .env and customize

# Secret key for encrypting stored SSH credentials (change in production!)
SECRET_KEY=change-me-in-production-32bytes!!

# Port exposed on the host (default: 3000)
PORT=3000

# ---- Authentication ----
# AUTH_PASSWORD を設定すると Web UI にパスワード認証が有効になります。
# 空のままにすると認証は無効（開発環境向け）。
AUTH_PASSWORD=

# 連続失敗でロックされるまでの回数（デフォルト: 5）
# AUTH_MAX_ATTEMPTS=5

# ロックアウト継続時間（分）（デフォルト: 15）
# AUTH_LOCKOUT_MINUTES=15

# トークン有効期限（時間）（デフォルト: 24）
# AUTH_TOKEN_EXPIRE_HOURS=24
