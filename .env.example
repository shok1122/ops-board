# OpsBoard environment variables
# Copy to .env and customize

# Secret key for encrypting stored SSH credentials (change in production!)
SECRET_KEY=change-me-in-production-32bytes!!

# Port exposed on the host (default: 3000)
PORT=3000

# ---- Authentication ----
# AUTH_PASSWORD を設定すると Web UI にパスワード認証が有効になります。
# 空のままにすると認証は無効（開発環境向け）。
AUTH_PASSWORD=

# 連続失敗でロックされるまでの回数（デフォルト: 5）
# AUTH_MAX_ATTEMPTS=5

# ロックアウト継続時間（分）（デフォルト: 15）
# AUTH_LOCKOUT_MINUTES=15

# トークン有効期限（時間）（デフォルト: 24）
# AUTH_TOKEN_EXPIRE_HOURS=24

# ---- Worker Ingest Logs ----
# ops-worker からの送信ログをサーバごとに直近何件保存するか（デフォルト: 100）
# WORKER_LOG_RETENTION=100

# ---- Timezone ----
# cron（ジョブ・通知チェック）の基準タイムゾーン（デフォルト: UTC）
# TZ=Asia/Tokyo

# ---- Teams 通知 ----
# Teams の Incoming Webhook / Workflow の URL。
# 設定しない場合、通知機能は使えない状態になります（画面上でもその旨を表示）。
TEAMS_WEBHOOK_URL=

# Webhook 送信のタイムアウト（秒）（デフォルト: 10）
# TEAMS_TIMEOUT_SEC=10

# 通知文に載せる OpsBoard ダッシュボードの URL（任意）
# TEAMS_DASHBOARD_URL=https://opsboard.example.com/
